<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <groupId>com.cc</groupId>
    <artifactId>english-quest</artifactId>
    <version>1.0.0</version>
    <name>english-quest</name>
    <description>基于游戏化机制的专升本英语闯关学习系统 - 后端服务</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.10.1</mybatis-plus.version>
        <hutool.version>5.8.35</hutool.version>
        <poi.version>5.4.0</poi.version>
        <pdfbox.version>2.0.31</pdfbox.version>
        <tess4j.version>5.11.0</tess4j.version>
    </properties>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- MyBatis-Plus (Spring Boot 3) -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- MyBatis-Plus 分页插件依赖 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.0.33</version>
            <scope>runtime</scope>
        </dependency>
        <!-- Hutool：JWT / BCrypt / 工具集 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>${hutool.version}</version>
        </dependency>
        <!--
          Apache POI：只用于「题库批量导入」读取 .xlsx / .xls。
          为什么不用 hutool 的 ExcelUtil：hutool-all 里只有 hutool-poi 的包装类，
          POI 本体并不在 hutool-all 之内，直接用会 NoClassDefFoundError，必须显式声明。
          ★ 代价：打包后的 jar 会明显变大（POI + xmlbeans + commons-compress 等）。
        -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <!--
          PDFBox：语法题库支持直接导入 PDF 题目。
          只用到 PDFTextStripper 这一小块（把字形序列还原成文字行），但它必须依赖
          fontbox 解析字体里的 ToUnicode CMap——中文 PDF 少这一步就是一堆乱码。
          ★ 选 2.x 而不是 3.x：2.x 的 API（PDDocument.load）稳定且网上资料多；
            3.x 把 PDF 读取拆成了 pdfbox-io，日志改成 log4j-api，对我们没有收益。
          ★ 扫描件（整页是图片）抽不出文字，这不是 PDFBox 的能力问题，是源文件没有文字层，
            业务层（GrammarPdfParser）会识别并给出明确提示，不做 OCR。
        -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>
        <!--
          Tess4J：给「扫描件 PDF」（整页是图片、没有文字层）做 OCR。
          ★ 它是 Tesseract 的 JNA 封装，native 库（tesseract/leptonica）已经打在 jar 里，
            不用另外装 tesseract.exe；但**词库 traineddata 不含**，要放在 tessdata 目录下。
          ★ 只用它做"图片 -> 文字"，题目结构仍然由 GrammarPdfParser 统一解析。
          ★ 识别慢（一页 1~2 秒），所以默认只识别前 N 页，见 app.ocr.max-pages。
        -->
        <dependency>
            <groupId>net.sourceforge.tess4j</groupId>
            <artifactId>tess4j</artifactId>
            <version>${tess4j.version}</version>
        </dependency>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>english-quest</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
