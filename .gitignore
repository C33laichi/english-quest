# ============================================================
#  english-quest · .gitignore
# ============================================================

# ---------- 敏感配置：一律不入库 ----------
# 真实数据库口令 / JWT secret 写在 application.yml 里，
# 仓库只保留 backend/src/main/resources/application-example.yml 作为模板。
backend/src/main/resources/application.yml
backend/src/main/resources/application-*.yml
!backend/src/main/resources/application-example.yml
.env
.env.*
!.env.example
*.local

# ---------- Java / Maven 构建产物 ----------
target/
build/
*.jar
*.war
*.class
!.mvn/wrapper/maven-wrapper.jar

# ---------- Node / 前端 ----------
node_modules/
dist/
dist_bak_*/
.vite/
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志 / 临时文件 ----------
*.log
logs/
*.tmp
*.bak
*~

# ---------- 本地自用、不上仓库 ----------
# 这几个是开发机上的临时文件 / 交付打包副本，对克隆者无意义
docs/
release/
前后端运行命令.txt
_本地自用_删除前备份/

# ---------- 开发期验证脚本：不上仓库 ----------
# 接口回归 / CDP 截图 / 视觉体检 / 数据修复等约 60 个脚本，全部依赖本机
# Chrome 路径、本机数据库和本机截图目录，克隆者拿到也用不了 —— 仓库只保留
# 可直接运行的源码 + sql + 音频 + 截图。scripts/ 仍在本机，只是不再入库。
scripts/

# ---------- 交付打包产物 ----------
*.apk

# ---------- 本地验证脚本产物 ----------
scripts/_shots/
*.png.tmp

# 截图目录里的临时调试图（下划线开头 = 过程留档，非交付用）
screenshots/_*.png
screenshots/T[0-9]-*.png
screenshots/crop_*.png
screenshots/diag-*.png

# ---------- 本次建仓用的本地工具（含真值，绝不入库） ----------
_sanitized/
_local_backup/
_apply_sanitized.py
_push_safe.py
_sanitize.py
_restore_local.py
