# ============================================================
#  english-quest · .gitignore
# ============================================================

# ---------- 敏感配置：一律不入库 ----------
# 真实数据库口令 / JWT secret 写在 application.yml 里，
# 仓库只保留 backend/src/main/resources/application-example.yml 作为模板。
backend/src/main/resources/application.yml
backend/src/main/resources/application-*.yml
!backend/src/main/resources/application-example.yml
.env
.env.*
!.env.example
*.local

# ---------- Java / Maven 构建产物 ----------
target/
build/
*.jar
*.war
*.class
!.mvn/wrapper/maven-wrapper.jar

# ---------- Node / 前端 ----------
node_modules/
dist/
dist_bak_*/
.vite/
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志 / 临时文件 ----------
*.log
logs/
*.tmp
*.bak
*~

# ---------- 交付打包产物 ----------
release/backend/*.jar
release/frontend/
release/*.zip
*.apk

# ---------- 本地验证脚本产物 ----------
scripts/_shots/
*.png.tmp

# 截图目录里的临时调试图（下划线开头 = 过程留档，非交付用）
screenshots/_*.png
screenshots/T[0-9]-*.png
screenshots/crop_*.png
screenshots/diag-*.png

# ---------- 本次建仓用的本地工具（含真值备份，绝不入库） ----------
_sanitized/
_local_backup/
_apply_sanitized.py
